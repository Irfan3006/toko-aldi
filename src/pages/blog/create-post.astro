---
import BlogLayout from '../../layouts/BlogLayout.astro';
---
<BlogLayout noindex={true}>
  <Fragment slot="head">
    <title>Create Post - Sibra Tech Blog</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/simplemde/latest/simplemde.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/font-awesome/4.7.0/css/font-awesome.min.css">
    <script is:inline src="https://cdn.jsdelivr.net/simplemde/latest/simplemde.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style is:inline>
      .editor-container { max-width: 800px; margin: 0 auto; }
    </style>
  </Fragment>

  <main class="container my-5 py-5 min-vh-80 editor-container">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4 p-md-5">
        <h2 class="fw-bold mb-4">Tulis Postingan Baru</h2>
        <form id="createPostForm" novalidate>
          <div class="mb-4">
            <label class="form-label fw-500">Judul Postingan</label>
            <input type="text" class="form-control form-control-lg" id="title" placeholder="Masukkan judul yang menarik..." required>
          </div>
          <div class="row mb-4">
            <div class="col-md-6 mb-3 mb-md-0">
              <label class="form-label fw-500">Kategori</label>
              <select class="form-select" id="category" required>
                <option value="" disabled selected>Pilih Kategori...</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-500">URL Gambar Thumbnail</label>
              <input type="url" class="form-control" id="thumbnail" placeholder="https://contoh.com/gambar.jpg">
              <div class="form-text text-muted">Opsional. Biarkan kosong untuk menggunakan thumbnail default.</div>
            </div>
          </div>
          <div class="mb-4">
            <label class="form-label fw-500">Konten (Markdown)</label>
            <textarea id="contentEditor"></textarea>
          </div>
          <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a href="/blog" class="btn btn-outline-secondary px-4">Batal</a>
            <button type="submit" class="btn btn-primary px-4 d-flex align-items-center gap-2" id="submitBtn">
              <span>Terbitkan Postingan</span>
              <div class="spinner-border spinner-border-sm d-none" role="status" id="loadingSpinner"></div>
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/assets/js/categories.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        Auth.requireAdmin();
        populateCategorySelect('category');

        const simplemde = new SimpleMDE({ 
          element: document.getElementById("contentEditor"),
          spellChecker: false,
          placeholder: "Tulis cerita Anda di sini..."
        });

        document.getElementById('createPostForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          const title = document.getElementById('title').value;
          const category = document.getElementById('category').value;
          const thumbnail = document.getElementById('thumbnail').value;
          const markdownContent = simplemde.value();
          
          if (!title || !title.trim()) {
            showToast('error', 'Error', 'Judul postingan tidak boleh kosong');
            return;
          }
          if (!category) {
            showToast('error', 'Error', 'Kategori tidak boleh kosong');
            return;
          }
          if (!markdownContent || !markdownContent.trim()) {
            showToast('error', 'Error', 'Konten postingan tidak boleh kosong');
            return;
          }
          const htmlContent = marked.parse(markdownContent);

          const postData = {
            title: title,
            category: category,
            thumbnail: thumbnail,
            content: htmlContent
          };

          const submitBtn = document.getElementById('submitBtn');
          const loadingSpinner = document.getElementById('loadingSpinner');
          submitBtn.disabled = true;
          loadingSpinner.classList.remove('d-none');
          submitBtn.querySelector('span').innerText = 'Menerbitkan...';

          const res = await API.createPost(postData);
          submitBtn.disabled = false;
          loadingSpinner.classList.add('d-none');
          submitBtn.querySelector('span').innerText = 'Terbitkan Postingan';

          if (res.success) {
            showToast('success', 'Postingan Diterbitkan!');
            setTimeout(() => { window.location.href = `/blog/post/${res.data.slug}`; }, 1500);
          } else { 
            showToast('error', 'Gagal menerbitkan', res.message); 
          }
        });
      });
    </script>
  </Fragment>
</BlogLayout>
