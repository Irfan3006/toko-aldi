<section id="alamat" class="py-5">
  <div class="container py-5">
    <div class="text-center mb-5" data-aos="fade-up" data-aos-offset="-300">
      <h2 class="fw-bold mb-3">Lokasi & Alamat</h2>
      <p class="text-muted">Kunjungi toko kami di alamat berikut</p>
    </div>

    <div class="row g-4">
      <div class="col-lg-5" data-aos="fade-right" data-aos-delay="100" data-aos-offset="-300">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-4">
            <div class="mb-4">
              <i class="bi bi-geo-alt-fill text-primary fs-1"></i>
            </div>
            <h4 class="fw-semibold mb-4">Toko Aldi Sembako</h4>
            <div class="address-info">
              <p class="mb-3">
                <i class="bi bi-map text-primary me-2"></i>
                <strong>Alamat:</strong><br />
                <span class="ms-4"
                  >Jalan Janti Gang Harjuna No. 45<br />
                  Banguntapan, Bantul<br />
                  Daerah Istimewa Yogyakarta<br />
                  55198</span
                >
              </p>
              <p class="mb-3">
                <i class="bi bi-telephone text-primary me-2"></i>
                <strong>Telepon:</strong><br />
                <span class="ms-4">
                  <a href="tel:+6281233974201" class="text-decoration-none">+62 812-3397-4201</a>
                </span>
              </p>
              <p class="mb-4">
                <i class="bi bi-whatsapp text-success me-2"></i>
                <strong>WhatsApp:</strong><br />
                <span class="ms-4">
                  <a href="https://wa.me/6281233974201" target="_blank" rel="noopener noreferrer" class="text-decoration-none">081233974201</a>
                </span>
              </p>
            </div>
            <a href="https://wa.me/6281233974201" class="btn btn-success w-100" target="_blank" rel="noopener noreferrer">
              <i class="bi bi-whatsapp me-2"></i>Hubungi via WhatsApp
            </a>
          </div>
        </div>
      </div>

      <div class="col-lg-7" data-aos="fade-left" data-aos-delay="100" data-aos-offset="-450">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-0">
            <div class="ratio ratio-4x3">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3953.4485795478477!2d110.40672897499638!3d-7.790210792224438!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a5a1d9f1e1d1d%3A0x1d1d1d1d1d1d1d1d!2sJl.%20Janti%20Gg.%20Harjuna%20No.45%2C%20Banguntapan%2C%20Bantul%2C%20Daerah%20Istimewa%20Yogyakarta!5e0!3m2!1sid!2sid!4v1234567890123!5m2!1sid!2sid"
                style="border: 0"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Lokasi Toko Aldi Sembako di Google Maps"
                aria-label="Peta lokasi Toko Aldi Sembako"
              >
              </iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
