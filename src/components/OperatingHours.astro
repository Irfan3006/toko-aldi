---
---
<section id="jam-buka" class="py-5 bg-light">
  <div class="container py-5">
    <div class="text-center mb-5" data-aos="fade-up" data-aos-offset="-300">
      <h2 class="fw-bold mb-3">Jam Operasional</h2>
      <p class="text-muted">Kami buka setiap hari untuk melayani Anda</p>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100" data-aos-offset="-300">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-center mb-4">
              <i class="bi bi-clock-history text-primary fs-1 me-3"></i>
              <h4 class="mb-0 text-primary">Buka Setiap Hari</h4>
            </div>

            <div class="schedule-list">
              <div class="schedule-item">
                <span class="day">Senin</span>
                <span class="hours">06.30 - 23.00</span>
              </div>
              <div class="schedule-item">
                <span class="day">Selasa</span>
                <span class="hours">06.30 - 23.00</span>
              </div>
              <div class="schedule-item">
                <span class="day">Rabu</span>
                <span class="hours">06.30 - 23.00</span>
              </div>
              <div class="schedule-item">
                <span class="day">Kamis</span>
                <span class="hours">06.30 - 23.00</span>
              </div>
              <div class="schedule-item">
                <span class="day">Jumat</span>
                <span class="hours">06.30 - 23.00</span>
              </div>
              <div class="schedule-item">
                <span class="day">Sabtu</span>
                <span class="hours">06.30 - 23.00</span>
              </div>
              <div class="schedule-item">
                <span class="day">Minggu</span>
                <span class="hours">06.30 - 23.00</span>
              </div>
            </div>

            <div class="alert alert-info mt-4 mb-0" role="alert">
              <i class="bi bi-info-circle me-2"></i>
              <strong>Catatan:</strong> Kami buka setiap hari tanpa libur untuk kemudahan Anda
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
