---
---
<section id="ulasan" class="py-5 bg-light">
  <div class="container py-5">
    <div class="text-center mb-5" data-aos="fade-up">
      <h2 class="fw-bold mb-3">Liputan Pers & Ulasan Pelanggan</h2>
      <p class="text-muted">Apa kata media dan pelanggan kami</p>
    </div>

    <div class="row g-4">
      <!-- Medium Article -->
      <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
        <div class="card h-100 border-0 shadow-sm hover-lift">
          <div class="card-body">
            <div class="mb-3">
              <i class="bi bi-newspaper text-primary fs-2"></i>
            </div>
            <h5 class="card-title fw-semibold mb-3">Liputan Medium</h5>
            <p class="card-text text-muted">"Bersahaja dan menyediakan kebutuhan primair yang diperlukan"</p>
            <div class="mt-3">
              <span class="badge bg-primary-subtle text-primary">Medium</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Review 1: KHM Sofwan -->
      <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
        <div class="card h-100 border-0 shadow-sm hover-lift">
          <div class="card-body">
            <div class="mb-3">
              <i class="bi bi-star-fill text-warning"></i>
              <i class="bi bi-star-fill text-warning"></i>
              <i class="bi bi-star-fill text-warning"></i>
              <i class="bi bi-star-fill text-warning"></i>
              <i class="bi bi-star-fill text-warning"></i>
            </div>
            <h6 class="card-subtitle mb-3 text-muted">KHM Sofwan</h6>
            <p class="card-text">"Itu toko menyediakan khas sembako dan harga sangat miring disamping pelayanan ramah"</p>
            <div class="mt-3">
              <span class="badge bg-success-subtle text-success"> <i class="bi bi-google"></i> Google Maps </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Review 2: Buhadi Yudiahmadi -->
      <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
        <div class="card h-100 border-0 shadow-sm hover-lift">
          <div class="card-body">
            <div class="mb-3">
              <i class="bi bi-star-fill text-warning"></i>
              <i class="bi bi-star-fill text-warning"></i>
              <i class="bi bi-star-fill text-warning"></i>
              <i class="bi bi-star-fill text-warning"></i>
              <i class="bi bi-star-fill text-warning"></i>
            </div>
            <h6 class="card-subtitle mb-3 text-muted">Buhadi Yudiahmadi</h6>
            <p class="card-text">"Nice, dengan pelayanan yang ramah juga tersedia berbagai macam kesediaan Sembako MANTAP JIWA"</p>
            <div class="mt-3">
              <span class="badge bg-success-subtle text-success"> <i class="bi bi-google"></i> Google Maps </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Review 3: Irfan Syarifudin -->
      <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100" data-aos-offset="-10">
        <div class="card h-100 border-0 shadow-sm hover-lift">
          <div class="card-body">
            <div class="mb-3">
              <i class="bi bi-star-fill text-warning"></i>
              <i class="bi bi-star-fill text-warning"></i>
              <i class="bi bi-star-fill text-warning"></i>
              <i class="bi bi-star-fill text-warning"></i>
              <i class="bi bi-star-fill text-warning"></i>
            </div>
            <h6 class="card-subtitle mb-3 text-muted">Irfan Syarifudin</h6>
            <p class="card-text">"Toko sembako yang lengkap dan strategis, pelayanannya sangat memuaskan!"</p>
            <div class="mt-3">
              <span class="badge bg-success-subtle text-success"> <i class="bi bi-google"></i> Google Maps </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
