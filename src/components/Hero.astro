---
---
<section id="hero" class="hero-section">
  <div class="container">
    <div class="row align-items-center min-vh-100">
      <div class="col-lg-7" data-aos="fade-up" data-aos-duration="1000">
        <h1 class="display-4 fw-bold mb-4 animate__animated animate__fadeIn pt-5">Toko Aldi Sembako Jogja: Minimarket Sembako Terlengkap & Murah</h1>
        <p class="lead mb-4 text-muted">
          Pusat sembako dan kebutuhan harian rumah tangga terlengkap di Banguntapan, Bantul, Yogyakarta dengan harga terjangkau, pelayanan ramah, dan lokasi strategis.
        </p>
        <div class="d-flex flex-wrap gap-3">
          <a
            href="https://wa.me/6281233974201"
            class="btn btn-success btn-lg px-4"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Hubungi kami via WhatsApp"
          >
            <i class="bi bi-whatsapp me-2"></i>WhatsApp Sekarang
          </a>
          <a href="#alamat" class="btn btn-outline-primary btn-lg px-4" aria-label="Lihat lokasi kami di Maps">
            <i class="bi bi-geo-alt me-2"></i>Lihat di Maps
          </a>
        </div>

        <!-- Payment Methods -->
        <div class="mt-4 pt-3" data-aos="fade-up" data-aos-delay="200">
          <p class="small text-muted mb-2">Metode Pembayaran:</p>
          <div class="d-flex flex-wrap gap-3 align-items-center">
            <span class="payment-badge" aria-label="Pembayaran tunai">
              <img src="/assets/images/payment-cash.svg" alt="Ikon pembayaran tunai" width="36" height="36" loading="lazy" />
              <span>Cash</span>
            </span>
            <span class="payment-badge" aria-label="Pembayaran QRIS">
              <img src="/assets/images/payment-qris.svg" alt="Ikon pembayaran QRIS" width="36" height="36" loading="lazy" />
              <span>QRIS</span>
            </span>
          </div>
        </div>
      </div>
      <div class="col-lg-5 text-center" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="200">
        <div class="hero-illustration mx-auto">
          <img src="/assets/images/hero-illustration.png" alt="Ilustrasi belanja sembako modern" width="360" height="360" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>
