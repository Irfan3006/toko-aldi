---
import { BLOG_CONFIG } from '../blog-config.js';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = BLOG_CONFIG.blogTitle,
  description = BLOG_CONFIG.blogDescription,
  keywords = 'Aldi Artikel, toko sembako Jogja, minimarket Banguntapan, sembako murah Bantul, promo sembako Yogyakarta, toko kelontong Jalan Janti',
  canonical,
  noindex = false
} = Astro.props;

const currentPath = Astro.url ? Astro.url.pathname : "/blog";
const computedCanonical = `${BLOG_CONFIG.siteUrl}${currentPath === "/" ? "/blog" : currentPath.replace(/\/$/, "")}`;
const finalCanonical = canonical || computedCanonical;
---
<!DOCTYPE html>
<html lang="id-ID">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#2D9C7F">
  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <>
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
      <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
      <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    </>
  )}
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon.png">

  <!-- Global Resource Hints for faster loading -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://unpkg.com">
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
  <link rel="dns-prefetch" href="https://unpkg.com">
  <link rel="dns-prefetch" href="https://script.google.com">

  <slot name="head" />
  
  <title>{title}</title>
  <meta name="description" content={description}>
  {keywords && <meta name="keywords" content={keywords}>}
  <link rel="canonical" href={finalCanonical}>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="id_ID">
  <meta property="og:site_name" content={title}>
  <meta property="og:url" content={finalCanonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://tokoaldi.biz.id/assets/images/og-image.jpg">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://tokoaldi.biz.id/assets/images/og-image.jpg">

  <!-- Fonts: Inter and Outfit -->
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Custom Blog Stylesheet -->
  <link rel="stylesheet" href="/assets/css/blog.css">
  
  <!-- AOS Animation Library -->
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <script is:inline src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
</head>
<body>
  <div id="navbar-placeholder"></div>
  
  <main class="flex-grow">
    <slot />
  </main>
  
  <div id="footer-placeholder"></div>

  <!-- Global scripts -->
  <script is:inline define:vars={{ scriptUrl: BLOG_CONFIG.scriptUrl }}>
    window.BLOG_SCRIPT_URL = scriptUrl;
  </script>
  
  <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script is:inline src="/assets/js/api.js"></script>
  <slot name="scripts" />
</body>
</html>
